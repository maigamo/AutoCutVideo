{
  "name": "autocutvideo-electron",
  "version": "1.0.0",
  "description": "AutoCutVideo - 视频批量下载与自动剪辑桌面应用",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild:dev": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "db:init": "node scripts/db-manager.cjs init",
    "db:migrate": "node scripts/db-manager.cjs migrate",
    "db:reset": "node scripts/db-manager.cjs reset",
    "db:repair": "node scripts/db-manager.cjs repair"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "dayjs": "^1.11.13",
    "electron-store": "^10.0.0",
    "element-plus": "^2.8.8",
    "file-type": "^19.6.0",
    "fluent-ffmpeg": "^2.1.3",
    "lodash-es": "^4.17.21",
    "pinia": "^2.2.6",
    "playwright": "^1.49.0",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.1.3",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.31.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.20.0 <19.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "electron",
    "video",
    "download",
    "edit",
    "automation",
    "ffmpeg",
    "playwright"
  ],
  "author": "",
  "license": "MIT"
}
